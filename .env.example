APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
TOP_CANDIDATES_LIMIT=5

# --- LLM Configuration (Candidate Mode) ---
# Set LLM_PROVIDER and your API key to enable AI-powered Candidate Mode features.
# Without a key, the app still works: skill gap and readiness score are deterministic.
# Recruiter Mode does NOT depend on these variables.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...your-key-here...
# Model is configurable; gpt-4o-mini is cost-efficient and fast.
OPENAI_MODEL=gpt-4o-mini
